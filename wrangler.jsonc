{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./workers/app.ts",
  "name": "bulkgreencoffee-com",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./build/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graycup-orders",
      "database_id": "c761625d-96b2-40a9-b1a3-4d9a58cae436"
    }
  ],
  "observability": {
    "enabled": true
  }
}
